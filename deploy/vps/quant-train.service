[Unit]
Description=Quant 全市场抓取 + CPU 训练
Documentation=https://github.com/xiongkong520/personal-quant
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__APP_DIR__
ExecStart=/bin/bash __APP_DIR__/deploy/vps/daily_train.sh
# 训练是 CPU 密集任务：让出优先级，别把机器压死
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=4h
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
