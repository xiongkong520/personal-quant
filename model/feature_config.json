  "features": [
    {
      "name": "ret_1d",
      "index": 0,
      "dtype": "float",
      "group": "个股动量",
      "formula": "close[t]/close[t-1]-1"
    },
    {
      "name": "ret_5d",
      "index": 1,
      "dtype": "float",
      "group": "个股动量",
      "formula": "close[t]/close[t-5]-1"
    },
    {
      "name": "ret_20d",
      "index": 2,
      "dtype": "float",
      "group": "个股动量",
      "formula": "close[t]/close[t-20]-1"
    },
    {
      "name": "excess_ret_5d",
      "index": 3,
      "dtype": "float",
      "group": "超额收益",
      "formula": "ret_5d - bench_ret_5d[t]（bench=沪深300，缺失时股票池等权）"
    },
    {
      "name": "excess_ret_10d",
      "index": 4,
      "dtype": "float",
      "group": "超额收益",
      "formula": "ret_10d - bench_ret_10d[t]"
    },
    {
      "name": "excess_ret_20d",
      "index": 5,
      "dtype": "float",
      "group": "超额收益",
      "formula": "ret_20d - bench_ret_20d[t]"
    },
    {
      "name": "amount_share",
      "index": 6,
      "dtype": "float",
      "group": "量能",
      "formula": "amount[t] / market_amount[t]（全市场成交额=上证+深证；缺失时股票池合计）"
    },
    {
      "name": "amount_share_ma5",
      "index": 7,
      "dtype": "float",
      "group": "量能",
      "formula": "amount_share 的 5 日均值"
    },
    {
      "name": "turnover_rate",
      "index": 8,
      "dtype": "float",
      "group": "量能",
      "formula": "换手率(%)（数据源提供；缺失填 0）"
    },
    {
      "name": "upper_shadow",
      "index": 9,
      "dtype": "float",
      "group": "K线形态",
      "formula": "(high[t]-max(open[t],close[t]))/pre_close[t]"
    },
    {
      "name": "lower_shadow",
      "index": 10,
      "dtype": "float",
      "group": "K线形态",
      "formula": "(min(open[t],close[t])-low[t])/pre_close[t]"
    },
    {
      "name": "body_ratio",
      "index": 11,
      "dtype": "float",
      "group": "K线形态",
      "formula": "(close[t]-open[t])/pre_close[t]"
    },
    {
      "name": "amplitude",
      "index": 12,
      "dtype": "float",
      "group": "K线形态",
      "formula": "(high[t]-low[t])/pre_close[t]"
    },
    {
      "name": "gap",
      "index": 13,
      "dtype": "float",
      "group": "K线形态",
      "formula": "open[t]/pre_close[t]-1"
    },
    {
      "name": "ma_bias_5",
      "index": 14,
      "dtype": "float",
      "group": "均线乖离",
      "formula": "close[t]/MA5[t]-1"
    },
    {
      "name": "ma_bias_20",
      "index": 15,
      "dtype": "float",
      "group": "均线乖离",
      "formula": "close[t]/MA20[t]-1"
    },
    {
      "name": "ma_bias_60",
      "index": 16,
      "dtype": "float",
      "group": "均线乖离",
      "formula": "close[t]/MA60[t]-1"
    },
    {
      "name": "volatility_5",
