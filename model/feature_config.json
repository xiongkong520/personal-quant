    },
    {
      "name": "sentiment_missing",
      "index": 25,
      "dtype": "float",
      "group": "涨跌停情绪",
      "formula": "该日之前涨跌停池数据是否缺失（1=缺失，用 0 填充）"
    },
    {
      "name": "pool_limit_up_count_lag1",
      "index": 26,
      "dtype": "float",
      "group": "股票池代理情绪",
